#:kivy 2.3.1
#:import EkranSabit sabitler.EkranSabit
#:import AnaPencereSabit sabitler.AnaPencereSabit

<PencereYonetici>:
    AnaPencere:
    
<DenemePencere>:
    name:"denemePencere"
    Label:
        text:"Burası Deneme Penceresi"


<AnaPencere>:
    canvas.before:
        Color:
            rgba:AnaPencereSabit.RENK
        Rectangle:
            size:self.size
            pos:self.pos
    id:anaPencere
    name:"anaPencere"
    BoxLayout:
        orientation:'horizontal'
        size_hint:1,1

        BoxLayout:
            id:solPanel
            orientation:'vertical'
            size_hint_x:EkranSabit.SOL_PANEL_GENISLIK_ORAN
            canvas.before:
                Color:
                    rgba:.2,.2,.2,1
                Rectangle:
                    size:self.size
                    pos:self.pos

            Label:
                text:"Burası Sol Panel"
            
        BoxLayout:
            orientation:'vertical'
            id:yarismaPanel
            size_hint_x:EkranSabit.SAHA_GENISLIK_ORAN

            BoxLayout:
                orientation:'horizontal'
                size_hint_y:EkranSabit.SAHA_UST_YUKSEKLIK_ORAN
                canvas.before:
                    Color:
                        rgba:.2,.2,.2,1
                    Rectangle:
                        size:self.size
                        pos:self.pos
                Label:
                    text:"Üst"
                
                
                    
            Saha:
                id:saha
                size_hint_y:EkranSabit.SAHA_YUKSEKLIK_ORAN

                #canvas.before:
                    #Color:
                        #rgba:AnaPencereSabit.SAHA_RENK
                    #Rectangle:
                        #size:self.size
                        #pos:self.pos


            BoxLayout:
                orientation:'horizontal'
                size_hint_y:EkranSabit.SAHA_ALT_YUKSEKLIK_ORAN
                canvas.before:
                    Color:
                        rgba:.2,.2,.2,1
                    Rectangle:
                        size:self.size
                        pos:self.pos
                Label:
                    text:"Alt"
                
                Button:
                    text:"Başlat"
                    on_press:root.yarisBaslatClick()
                    


        BoxLayout:
            orientation:'vertical'
            id:sagPanel
            size_hint_x:EkranSabit.SAG_PANEL_GENISLIK_ORAN
            canvas.before:
                Color:
                    rgba:.2,.2,.2,1
                Rectangle:
                    size:self.size
                    pos:self.pos
            Label:
                text:"Burası Sağ Panel"