#:kivy 2.3.1
#:import EkranSabit sabitler.EkranSabit
#:import AnaPencereSabit sabitler.AnaPencereSabit
#:import DikdortgenTip sabitler.DikdortgenTip

<NeonPanel@BoxLayout>:
    border_color: 0, 1, 0.4, 1
    bg_color: 0.07, 0.09, 0.12, 0.95
    orientation: 'vertical'
    padding: 12
    spacing: 10
    canvas.before:
        #Color:
            #rgba: self.bg_color
        #RoundedRectangle:
            #pos: self.pos
            #size: self.size
            #radius: [10,]
        Color:
            rgba: self.border_color
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
            width:1.5

<PencereYonetici>:
    AnaPencere:
    
<DenemePencere>:
    name:"deneme_pencere"
    Label:
        text:"Burası Deneme Penceresi"


<AnaPencere>:
    bosluk: self.width/EkranSabit.BOSLUK_ORAN if self.width>self.height else self.height/EkranSabit.BOSLUK_ORAN
    canvas.before:
        Color:
            rgba:AnaPencereSabit.RENK
        Rectangle:
            size:self.size
            pos:self.pos
    id:ana_pencere
    name:"ana_pencere"
    BoxLayout:
        orientation:'horizontal'
        size_hint:1,1
        
        spacing:ana_pencere.bosluk
        padding:ana_pencere.bosluk
        

        NeonPanel:
            id:sol_panel
            orientation:'vertical'
            size_hint_x:EkranSabit.SOL_PANEL_GENISLIK_ORAN
            #canvas.before:
                #Color:
                    #rgba:.2,.2,.2,1
                #Rectangle:
                    #size:self.size
                    #pos:self.pos

            Label:
                text:"Sol Panel"
            
        NeonPanel:
            orientation:'vertical'
            id:yarisma_panel
            size_hint_x:EkranSabit.SAHA_GENISLIK_ORAN

            
            
            NeonPanel:
                orientation:'horizontal'
                size_hint_y:EkranSabit.SAHA_UST_YUKSEKLIK_ORAN
                #canvas.before:
                    #Color:
                        #rgba:.2,.2,.2,1
                    #Rectangle:
                        #size:self.size
                        #pos:self.pos
                Label:
                    text:'Üst Panel'
            
            
                
                
                    
            Saha:
                id:saha
                size_hint_y:EkranSabit.SAHA_YUKSEKLIK_ORAN

                #canvas.before:
                    #Color:
                        #rgba:AnaPencereSabit.SAHA_RENK
                        #rgba: 0.1, 0.5, 0.2, 1  
                    #Rectangle:
                        #size:self.size
                        #pos:self.pos


            NeonPanel:
                orientation:'horizontal'
                size_hint_y:EkranSabit.SAHA_ALT_YUKSEKLIK_ORAN
                #canvas.before:
                    #Color:
                        #rgba:.2,.2,.2,1
                    #Rectangle:
                        #size:self.size
                        #pos:self.pos
                Label:
                    text:"Alt Panel"
                
                Button:
                    text:"Başlat"
                    on_press:root.yaris_baslat_tiklama()
                    


        NeonPanel:
            orientation:'vertical'
            id:sag_panel
            size_hint_x:EkranSabit.SAG_PANEL_GENISLIK_ORAN
            #canvas.before:
                #Color:
                    #rgba:.2,.2,.2,1
                #Rectangle:
                    #size:self.size
                    #pos:self.pos
            Label:
                text:"Sağ Panel"